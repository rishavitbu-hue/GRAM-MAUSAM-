# ==============================================================================
# GramMausam (ग्राममौसम) Environment Configuration Template
# Smart India Hackathon 2026 - Problem Statement: SIH26086
# Ministry of Earth Sciences (MoES) / India Meteorological Department (IMD)
# ==============================================================================

# Server Runtime Settings
PORT=8000
ENVIRONMENT=development
DEBUG=false
CORRELATION_LOGGING=true

# Meteorological & Remote Sensing API Endpoints (Tokens kept as placeholders)
IMD_AWS_ARG_API_KEY=YOUR_IMD_OPEN_DATA_KEY_HERE
NCMRWF_NWP_ENDPOINT=https://ncmrwf.gov.in/api/v2/grids
INSAT_3D_SATELLITE_KEY=YOUR_INSAT3D_ACCESS_KEY
WINDS_GROUND_STATION_TOKEN=YOUR_AGRI_WINDS_TOKEN_HERE

# Central Ground Water Board (CGWB) Telemetry
CGWB_PIEZOMETER_API_ENDPOINT=https://cgwb.gov.in/telemetry/v1
CGWB_AUTH_TOKEN=YOUR_CGWB_READ_ONLY_TOKEN

# Agri Stack & Multi-Channel Farmer Advisory Gateways
AGRI_STACK_API_SECRET=YOUR_AGRI_STACK_CONSENT_KEY
WHATSAPP_BUSINESS_API_TOKEN=YOUR_META_WA_TOKEN_HERE
KVK_BULK_SMS_GATEWAY_KEY=YOUR_TRAI_DLT_REGISTERED_SMS_TOKEN

# Machine Learning Inference Model Engine
MODEL_INFERENCE_RUNTIME=local_onnx_pytorch
ENSO_IOD_MJO_TELEMETRY_REFRESH_MINUTES=60
